WIDGET_ENVIRONMENT=development
WIDGET_JWT_SECRET=replace-with-at-least-32-random-characters
WIDGET_AMUL_API_BASE_URL=https://api.prod.amulai.in
WIDGET_REDIS_URL=redis://127.0.0.1:6379/2
WIDGET_REDIS_KEY_PREFIX=amul-widget

